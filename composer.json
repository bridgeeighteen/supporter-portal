{
    "name": "bridgeeighteen/supporter-portal",
    "description": "The Bridge Eighteen Community's supporter portal. It should be used together with NFC cards or labels include a NTAG chip or follow the NFC Forum Tag Type 1 standard.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Diamochang (Mike Wang)",
            "email": "diamochang@yeah.net",
            "role": "Developer"
        }
    ],
    "homepage": "https://codeberg.org/bridgeeighteen/supporter-portal",
    "support": {
        "issues": "https://codeberg.org/bridgeeighteen/supporter-portal/issues"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://afdian.com/a/Diamochang"
        }
    ],
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "catfan/medoo": "^2.1",
        "monolog/monolog": "^3.0",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "BECSP\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}